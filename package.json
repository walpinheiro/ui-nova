{
  "name": "vueui-nova-kit",
  "version": "1.0.0-rc.4",
  "description": "VueUI Nova Component Kit",
  "private": false,
  "main": "./dist/vueui-nova.umd.cjs",
  "module": "./dist/vueui-nova.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "**/*.css",
    "*.scss",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vueui-nova.es.js",
      "require": "./dist/vueui-nova.umd.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/export.d.ts",
      "import": "./dist/tokens.es.js",
      "default": "./dist/tokens.es.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./style.css": "./dist/vueui-nova-kit.css",
    "./index.css": "./dist/vueui-nova-kit.css"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:treeshake": "node scripts/verify-treeshake.cjs",
    "test:e2e": "playwright test",
    "shot": "node scripts/shot.cjs",
    "harness": "node scripts/val-harness-server.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:coverage": "node scripts/storybook-coverage.cjs",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit",
    "build:types": "node scripts/build-types.cjs",
    "test:types": "node scripts/verify-component-types.cjs",
    "build": "vite build && vite build --config vite.tokens.config.ts && npm run build:types",
    "prepublishOnly": "npm run build && npm test && npm run test:treeshake && npm run test:types",
    "tokens:sync": "node scripts/sync-known-tokens.mjs",
    "tokens:validate": "node scripts/validate-token-cascade.mjs"
  },
  "peerDependencies": {
    "vue": "^3.3.0 || ^3.4.0 || ^3.5.0"
  },
  "dependencies": {
    "@iconify-icons/keyline-icons": "^2.0.7",
    "@iconify/types": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/vue3-vite": "^9.0.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.104.1",
    "storybook": "^9.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}